# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno DUMMY para CI (GitHub Actions).
# NO usar estos valores en producción ni en local. Son intencionalmente débiles
# para que el pipeline pueda levantarse sin secretos.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=mantenimientos_ci
POSTGRES_USER=ci_user
POSTGRES_PASSWORD=ci_password_dummy

# Django
DJANGO_SECRET_KEY=ci-dummy-secret-key-not-for-production-use-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Ollama (no se usa en CI; se deja para que el contenedor arranque)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
